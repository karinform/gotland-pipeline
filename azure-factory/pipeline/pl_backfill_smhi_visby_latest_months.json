{
	"name": "pl_backfill_smhi_visby_latest_months",
	"properties": {
		"description": "Backfill",
		"activities": [
			{
				"name": "Set_Backfill_File_Name",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "file_name",
					"value": "@concat('backfill_smhi_visby_latest_months_', formatDateTime(utcNow(), 'yyyyMMdd_HHmmss'), '.json')"
				}
			},
			{
				"name": "Copy_SMHI_Visby_Backfill_To_Raw_Blob",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set_Backfill_File_Name",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_smhi_visby_latest_months_json",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_blob_raw_visby_smhi_json",
						"type": "DatasetReference",
						"parameters": {
							"file_name": "@variables('file_name')"
						}
					}
				]
			}
		],
		"variables": {
			"file_name": {
				"type": "String"
			}
		},
		"annotations": []
	}
}