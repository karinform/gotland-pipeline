{
	"name": "pl_ingest_smhi_visby_hourly",
	"properties": {
		"activities": [
			{
				"name": "Copy_SMHI_Visby_To_Raw_Blob",
				"type": "Copy",
				"dependsOn": [
					{
						"activity": "Set_File_Name",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "JsonSink",
						"storeSettings": {
							"type": "AzureBlobStorageWriteSettings"
						},
						"formatSettings": {
							"type": "JsonWriteSettings"
						}
					},
					"enableStaging": false
				},
				"inputs": [
					{
						"referenceName": "ds_smhi_visby_latest_hour_json",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_blob_raw_visby_smhi_json",
						"type": "DatasetReference",
						"parameters": {
							"file_name": "@variables('file_name')"
						}
					}
				]
			},
			{
				"name": "Copy_Raw_Blob_To_Snowflake",
				"type": "Copy",
				"state": "Inactive",
				"onInactiveMarkAs": "Succeeded",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobStorageReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "SnowflakeV2Sink",
						"importSettings": {
							"type": "SnowflakeImportCopyCommand"
						}
					},
					"enableStaging": true,
					"stagingSettings": {
						"linkedServiceName": {
							"referenceName": "ls_blob_gotland_sas",
							"type": "LinkedServiceReference"
						},
						"path": "staging/adf-snowflake/"
					},
					"translator": {
						"type": "TabularTranslator",
						"mapComplexValuesToString": true
					}
				},
				"inputs": [
					{
						"referenceName": "ds_blob_raw_visby_smhi_json",
						"type": "DatasetReference",
						"parameters": {
							"file_name": "@variables('file_name')"
						}
					}
				],
				"outputs": [
					{
						"referenceName": "ds_snowflake_raw_visby_rainfall",
						"type": "DatasetReference"
					}
				]
			},
			{
				"name": "Set_File_Name",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "file_name",
					"value": {
						"value": "@concat('gotland_smhi_visby_', formatDateTime(utcNow(), 'yyyyMMdd_HHmmss'), '.json')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Load_Blob_To_Snowflake",
				"type": "Script",
				"dependsOn": [
					{
						"activity": "Copy_SMHI_Visby_To_Raw_Blob",
						"dependencyConditions": [
							"Completed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"linkedServiceName": {
					"referenceName": "ls_snowflake_gotland",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": "COPY INTO GOTLAND_RAIN.RAW.VISBY_RAINFALL_JSON_RAW (raw_data, source_file)\nFROM (\n    SELECT\n        $1,\n        METADATA$FILENAME\n    FROM @GOTLAND_RAIN.RAW.AZURE_SMHI_VISBY_STAGE\n)\nFILE_FORMAT = GOTLAND_RAIN.RAW.JSON_FORMAT\nON_ERROR = 'CONTINUE';"
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00",
					"treatDecimalAsString": false
				}
			}
		],
		"variables": {
			"file_name": {
				"type": "String"
			}
		},
		"annotations": []
	}
}